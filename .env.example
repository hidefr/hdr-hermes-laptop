# =============================================================================
# Hermes Laptop Appliance - Environment Configuration Template
# Copy this file to .env and populate with your own credentials.
# =============================================================================

# Primary LLM API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Messaging Gateway
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=your_telegram_user_id_here

# Optional: Groq Whisper API (for high-speed cloud voice transcription fallback)
# GROQ_API_KEY=your_groq_api_key_here

# Optional: GitHub Personal Access Token (raises Skills Hub rate limit from 60 to 5000 req/hr)
# GITHUB_TOKEN=your_github_token_here
